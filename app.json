{
  "expo": {
    "name": "TripTastic",
    "slug": "triptastic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "triptastic",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TripTastic shows your location on the map so you can see nearby trip destinations.",
        "NSPhotoLibraryUsageDescription": "TripTastic uses your photos for your profile picture and trip cover images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.cianmccarthyucc.triptastic"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/transparent-logo-light.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBD4",
          "dark": {
            "image": "./assets/images/logo/transparent-logo-dark.png",
            "backgroundColor": "#2E2910"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfec5f6c-bde2-471f-b4da-d22b92b99412"
      }
    },
    "owner": "cianmccarthyucc",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cfec5f6c-bde2-471f-b4da-d22b92b99412"
    }
  }
}
